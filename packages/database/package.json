{
  "name": "@novacommerce/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "dotenv -o -e ../../.env -- prisma generate",
    "migrate:deploy": "dotenv -o -e ../../.env -- prisma migrate deploy",
    "migrate:deploy:docker": "prisma migrate deploy",
    "seed:dev": "dotenv -o -e ../../.env -- prisma db execute --file prisma/migrations/20250910000000_identity_rbac_audit/seed_permissions.sql && dotenv -o -e ../../.env -- prisma db execute --file prisma/seed/seed_admin_user.sql",
    "migrate:dev": "dotenv -o -e ../../.env -- prisma migrate dev",
    "validate": "dotenv -o -e ../../.env -- prisma validate",
    "format": "prisma format",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@novacommerce/building-blocks": "workspace:*",
    "@prisma/client": "6.5.0"
  },
  "devDependencies": {
    "dotenv-cli": "8.0.0",
    "prisma": "6.5.0",
    "typescript": "5.8.2",
    "vitest": "3.0.9"
  }
}
