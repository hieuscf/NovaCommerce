# =============================================================================
# NovaCommerce - Environment Variables
# Copy to .env and adjust values for your environment.
# Never commit .env with real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
WEB_PORT=3001
ADMIN_PORT=3002
AI_PORT=8000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=novacommerce
POSTGRES_PASSWORD=change-me
POSTGRES_DB=novacommerce
# Host port for Docker Postgres (5433 avoids conflict with a local PostgreSQL on 5432)
POSTGRES_HOST_PORT=5433
# Local dev: host machine → Docker published port
DATABASE_URL=postgresql://novacommerce:change-me@localhost:5433/novacommerce?schema=public

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0

# -----------------------------------------------------------------------------
# OpenSearch
# -----------------------------------------------------------------------------
OPENSEARCH_URL=http://localhost:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# Optional product search index name (default: novacommerce-products)
# OPENSEARCH_PRODUCT_INDEX=novacommerce-products

# Optional product search query cache (Redis ICache). Short TTL because
# ProductCreated / ProductUpdated can change the OpenSearch index.
# SEARCH_CACHE_ENABLED=true
# SEARCH_CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# MinIO (Object Storage)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=novacommerce
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=localhost:9000
# MINIO_PORT=9000
MINIO_ACCESS_KEY=novacommerce
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=novacommerce
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# Authentication (Identity module)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
PASSWORD_HASH_COST=16384
PASSWORD_RESET_TOKEN_TTL=1h

# -----------------------------------------------------------------------------
# Gateway CORS (comma-separated browser origins)
# Development defaults to http://localhost:3001,http://localhost:3002 when unset.
# Production must set this explicitly or CORS stays disabled.
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# -----------------------------------------------------------------------------
# AI Service
# -----------------------------------------------------------------------------
AI_SERVICE_URL=http://ai-service:8000

# -----------------------------------------------------------------------------
# Frontend (public / browser-safe only — never put secrets in NEXT_PUBLIC_*)
# Also documented in apps/web/.env.example and apps/admin/.env.example
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
# Internal design-system reference page (/design-system). Always available
# outside production; in production it stays 404 unless explicitly set to true.
# NEXT_PUBLIC_ENABLE_DESIGN_SYSTEM=false

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=5000
# Outbox worker also consumes ProductCreated/ProductUpdated for Search indexing.
# OPENSEARCH_URL above is required for that consumer.

# -----------------------------------------------------------------------------
# External Services (configure when integrating)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# GEMINI_API_KEY=
