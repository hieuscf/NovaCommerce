# Public Gateway origin. Exposed to the browser on purpose.
# Never put JWT secrets, database URLs, or provider keys here.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Development-only auth adapter. Ignored in production.
# Leave unset to call the real Gateway Identity API.
# Use `mock` only to exercise Login/Register UI without Gateway.
# NEXT_PUBLIC_AUTH_ADAPTER=mock

# Internal design-system reference page (/design-system). Always available
# outside production; in production it stays 404 unless explicitly set to true.
# NEXT_PUBLIC_ENABLE_DESIGN_SYSTEM=false
