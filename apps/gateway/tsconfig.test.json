{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@novacommerce/building-blocks": ["../../packages/building-blocks/dist/index.d.ts"],
      "@novacommerce/database": ["../../packages/database/dist/index.d.ts"],
      "@novacommerce/infrastructure": ["../../packages/infrastructure/dist/index.d.ts"],
      "@prisma/client": ["../../node_modules/.pnpm/@prisma+client@6.5.0_prisma@6.5.0_typescript@5.8.2__typescript@5.8.2/node_modules/@prisma/client"],
      "vitest": ["node_modules/vitest/dist/index.d.ts"],
      "vitest/*": ["node_modules/vitest/*"]
    }
  },
  "include": [
    "src/**/*.test.ts",
    "../../modules/identity/**/*.test.ts",
    "../../modules/user/**/*.test.ts",
    "../../modules/catalog/**/*.test.ts",
    "../../modules/inventory/**/*.test.ts"
  ],
  "exclude": []
}
